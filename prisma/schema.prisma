generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

generator client2 {
  provider     = "prisma-client-js"
  output       = "../generated/prisma2"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
  
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  level     Int        @default(1)
  xp        Int        @default(0)
  wins      Int        @default(0)
  losses    Int        @default(0)
  roles     UserRole[] 
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  initiatedBattles Battle[] @relation("InitiatedBattles")
  opponentBattles  Battle[] @relation("OpponentBattles")
  wonBattles       Battle[] @relation("WonBattles")

}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique // ADMIN | USER
  users     UserRole[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Character {
  id            Int      @id @default(autoincrement())
  name          String
  hp            Int
  baseHp        Int
  attack        Int
  levelRequired Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  initiatedInBattles Battle[] @relation("InitiatorCharacterBattles")
  opponentInBattles  Battle[] @relation("OpponentCharacterBattles")

}

enum BattleMode{
  PVP
  PVE
}

enum BattleStatus{
  IN_PROGRESS
  FINISHED
}

enum BattleTurn {
  INITIATOR
  OPPONENT
}

model Battle {
  id                   Int          @id @default(autoincrement())
  mode                 BattleMode
  status               BattleStatus @default(IN_PROGRESS)

  initiatorUserId      Int
  opponentUserId       Int?
  winnerUserId         Int?
  winnerIsMachine      Boolean      @default(false)

  initiatorCharacterId Int
  opponentCharacterId  Int

  initiatorCurrentHp   Int @default(1)
  opponentCurrentHp    Int @default(1)

  turnNumber           Int          @default(1)
  nextTurn             BattleTurn   @default(INITIATOR)

  initiatorUser        User         @relation("InitiatedBattles", fields: [initiatorUserId], references: [id])
  opponentUser         User?        @relation("OpponentBattles", fields: [opponentUserId], references: [id])
  winnerUser           User?        @relation("WonBattles", fields: [winnerUserId], references: [id])

  initiatorCharacter   Character    @relation("InitiatorCharacterBattles", fields: [initiatorCharacterId], references: [id])
  opponentCharacter    Character    @relation("OpponentCharacterBattles", fields: [opponentCharacterId], references: [id])

  endedAt              DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

