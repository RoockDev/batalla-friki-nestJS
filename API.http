@baseUrl = http://localhost:3000

### ==================================================
### 0) CORRECCION RAPIDA (RESET + SEED + OVERVIEW)
### ==================================================

### Vaciar base de datos
POST {{baseUrl}}/demo/clear

### Poblar datos demo (roles + admin + users + characters)
POST {{baseUrl}}/demo/seed

### Ver resumen para corregir (usuarios/roles/personajes)
GET {{baseUrl}}/demo/overview

### ==================================================
### 1) AUTH
### ==================================================

### Login admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@batalla.com",
  "password": "123456"
}

### Login user1
# @name loginUser1
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user1@batalla.com",
  "password": "123456"
}

### Login user2
# @name loginUser2
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user2@batalla.com",
  "password": "123456"
}

###
@tokenAdmin = {{loginAdmin.response.body.data.access_token}}
@tokenUser1 = {{loginUser1.response.body.data.access_token}}
@tokenUser2 = {{loginUser2.response.body.data.access_token}}

### Registro user nuevo (opcional)
# @name registerNewUser
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "nuevo_user_test@batalla.com",
  "password": "123456"
}

### ==================================================
### 2) CHARACTERS + RANKING
### ==================================================

### Listar personajes (requiere token)
GET {{baseUrl}}/characters
Authorization: Bearer {{tokenUser1}}

### Ranking top 10 (requiere token)
GET {{baseUrl}}/users/ranking?limit=10
Authorization: Bearer {{tokenUser1}}

### ==================================================
### 3) BATTLE PVE (USER vs MAQUINA)
### ==================================================
### IMPORTANTE:
### Si cambian los IDs, mira /demo/overview o /characters y ajusta:
### user1CharId (debe cumplir levelRequired de user1)
### machineCharId (distinto a user1CharId)

@user1CharId = 7
@machineCharId = 8

### Crear batalla PVE
# @name startPve
POST {{baseUrl}}/battles/start/pve
Authorization: Bearer {{tokenUser1}}
Content-Type: application/json

{
  "myCharacterId": {{user1CharId}},
  "machineCharacterId": {{machineCharId}}
}

###
@pveBattleId = {{startPve.response.body.data.battleId}}

### Ver estado PVE
GET {{baseUrl}}/battles/{{pveBattleId}}
Authorization: Bearer {{tokenUser1}}

### Turno PVE 1
POST {{baseUrl}}/battles/{{pveBattleId}}/turn/pve
Authorization: Bearer {{tokenUser1}}

### Turno PVE 2
POST {{baseUrl}}/battles/{{pveBattleId}}/turn/pve
Authorization: Bearer {{tokenUser1}}

### Turno PVE 3
POST {{baseUrl}}/battles/{{pveBattleId}}/turn/pve
Authorization: Bearer {{tokenUser1}}

### Estado PVE final/actual
GET {{baseUrl}}/battles/{{pveBattleId}}
Authorization: Bearer {{tokenUser1}}

### ==================================================
### 4) BATTLE PVP (WAITING + JOIN + TURNOS)
### ==================================================
### IMPORTANTE:
### pvpCharUser1 y pvpCharUser2 deben ser distintos
### y cumplir nivel requerido de cada usuario.

@pvpCharUser1 = 7
@pvpCharUser2 = 9

### USER1 crea batalla PVP (queda WAITING)
# @name createPvpWaiting
POST {{baseUrl}}/battles/start/pvp
Authorization: Bearer {{tokenUser1}}
Content-Type: application/json

{
  "myCharacterId": {{pvpCharUser1}}
}

###
@pvpBattleId = {{createPvpWaiting.response.body.data.battleId}}

### USER2 se une a batalla PVP
POST {{baseUrl}}/battles/{{pvpBattleId}}/join/pvp
Authorization: Bearer {{tokenUser2}}
Content-Type: application/json

{
  "myCharacterId": {{pvpCharUser2}}
}

### Ver estado PVP (user1)
GET {{baseUrl}}/battles/{{pvpBattleId}}
Authorization: Bearer {{tokenUser1}}

### Turno PVP 1 (normalmente inicia USER1)
POST {{baseUrl}}/battles/{{pvpBattleId}}/turn
Authorization: Bearer {{tokenUser1}}

### Turno PVP 2 (normalmente USER2)
POST {{baseUrl}}/battles/{{pvpBattleId}}/turn
Authorization: Bearer {{tokenUser2}}

### Turno PVP 3
POST {{baseUrl}}/battles/{{pvpBattleId}}/turn
Authorization: Bearer {{tokenUser1}}

### Estado PVP final/actual
GET {{baseUrl}}/battles/{{pvpBattleId}}
Authorization: Bearer {{tokenUser1}}

### ==================================================
### 5) AUTHZ (PRUEBAS DE SEGURIDAD)
### ==================================================

### USER2 intenta jugar turno PVE de USER1 -> debe dar 403
POST {{baseUrl}}/battles/{{pveBattleId}}/turn/pve
Authorization: Bearer {{tokenUser2}}

### USER2 intenta ver detalle de PVE de USER1 -> debe dar 403
GET {{baseUrl}}/battles/{{pveBattleId}}
Authorization: Bearer {{tokenUser2}}

### ==================================================
### 6) NOTA WS
### ==================================================
### Las operaciones de batalla se ejecutan por HTTP.
### WebSocket se usa para emitir eventos en tiempo real (battle-updated)
### a los clientes conectados a la room de batalla.
